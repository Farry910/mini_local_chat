<UserControl x:Class="MiniLocalChat.Controls.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:MiniLocalChat.Models"
             xmlns:c="clr-namespace:MiniLocalChat.Controls"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
             Background="{StaticResource ChatBackgroundBrush}">
    <UserControl.Resources>

        <!-- Text, image or file card, depending on the message kind -->
        <DataTemplate x:Key="MessageBodyTemplate" DataType="{x:Type m:ChatMessage}">
            <Grid>
                <TextBlock x:Name="TextPart" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                           FontFamily="{StaticResource TextFont}" Foreground="{StaticResource TextBrush}" />

                <Image x:Name="ImagePart" Visibility="Collapsed" Stretch="Uniform" StretchDirection="DownOnly"
                       MaxHeight="280" Cursor="Hand" ToolTip="{Binding FileName}" MouseLeftButtonUp="OnImageClick"
                       MaxWidth="{Binding ImageMaxWidth, RelativeSource={RelativeSource AncestorType=c:ChatView}}"
                       Source="{Binding LocalPath, Converter={StaticResource PathToImage}}" />

                <Grid x:Name="FilePart" Visibility="Collapsed" MinWidth="190">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.RowSpan="2" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="26"
                               FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}" Text="&#xE8A5;" />
                    <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" Orientation="Horizontal">
                        <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                                   Text="{Binding FileSize, Converter={StaticResource FileSize}}" />
                        <TextBlock Margin="12,0,0,0" FontSize="12">
                            <Hyperlink Click="OnOpenAttachment" Foreground="{StaticResource AccentBrush}">Open</Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="10,0,0,0" FontSize="12">
                            <Hyperlink Click="OnShowInFolder" Foreground="{StaticResource AccentBrush}">Show in folder</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Image">
                    <Setter TargetName="TextPart" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ImagePart" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="File">
                    <Setter TargetName="TextPart" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FilePart" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ContextMenu x:Key="BubbleMenu" x:Shared="False">
            <MenuItem Header="Copy" Click="OnCopyMessage" />
        </ContextMenu>

        <!-- Someone else's message: avatar, name (groups), time, white bubble on the left -->
        <DataTemplate x:Key="OtherMessageTemplate" DataType="{x:Type m:ChatMessage}">
            <Grid Margin="0,6,48,0" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:Avatar Width="32" Height="32" Margin="0,2,10,0" VerticalAlignment="Top"
                          Text="{Binding Sender.Initials}" Fill="{Binding Sender.AvatarBrush}" Ring="{Binding Sender.RingBrush}"
                          Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=c:ChatView}, Converter={StaticResource InverseBoolToVisibility}}" />
                <StackPanel Grid.Column="1">
                    <StackPanel Margin="0,0,0,3" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   Text="{Binding Sender.DisplayName}"
                                   Visibility="{Binding DataContext.IsGroup, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                                   Text="{Binding SentUtc, Converter={StaticResource MessageTime}}" />
                    </StackPanel>
                    <Border HorizontalAlignment="Left" Padding="12,8" CornerRadius="6" Background="White"
                            ContextMenu="{StaticResource BubbleMenu}"
                            MaxWidth="{Binding BubbleMaxWidth, RelativeSource={RelativeSource AncestorType=c:ChatView}}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageBodyTemplate}" Focusable="False" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- My message: time, lavender bubble on the right, delivery status -->
        <DataTemplate x:Key="MineMessageTemplate" DataType="{x:Type m:ChatMessage}">
            <StackPanel Margin="48,6,0,0" HorizontalAlignment="Right">
                <TextBlock Margin="0,0,0,3" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                           Text="{Binding SentUtc, Converter={StaticResource MessageTime}}" />
                <Border HorizontalAlignment="Right" Padding="12,8" CornerRadius="6" Background="{StaticResource AccentLightBrush}"
                        ContextMenu="{StaticResource BubbleMenu}"
                        MaxWidth="{Binding BubbleMaxWidth, RelativeSource={RelativeSource AncestorType=c:ChatView}}">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageBodyTemplate}" Focusable="False" />
                </Border>
                <TextBlock Margin="0,2,2,0" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                           Text="{Binding DeliveryText}"
                           Visibility="{Binding DeliveryText, Converter={StaticResource EmptyToCollapsed}}" />
            </StackPanel>
        </DataTemplate>

        <c:MessageTemplateSelector x:Key="MessageSelector"
                                   Mine="{StaticResource MineMessageTemplate}"
                                   Other="{StaticResource OtherMessageTemplate}" />

        <Style x:Key="ComposerBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmojiButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontFamily" Value="Segoe UI Emoji" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="ChatRoot" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border x:Name="Header" Padding="20,10" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <c:Avatar Width="36" Height="36" Margin="0,0,12,0"
                              Text="{Binding AvatarText}" Fill="{Binding AvatarBrush}" Ring="{Binding AvatarRing}" IsGroup="{Binding IsGroup}"
                              ShowPresence="{Binding IsGroup, Converter={StaticResource InverseBool}}"
                              IsOnline="{Binding Peer.IsOnline, FallbackValue=False}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <!-- 1:1: presence + IP. Group: member list. -->
                        <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsGroup, Converter={StaticResource InverseBoolToVisibility}}">
                            <Run Text="{Binding Peer.IsOnline, Mode=OneWay, Converter={StaticResource PresenceText}, FallbackValue=''}" />
                            <Run Text="·" />
                            <Run Text="{Binding Subtitle, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Subtitle}" Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Messages -->
            <ItemsControl x:Name="MessageList" Grid.Row="1" Padding="20,4,20,12" Focusable="False"
                          ItemsSource="{Binding Messages}" ItemTemplateSelector="{StaticResource MessageSelector}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="Scroller" CanContentScroll="True" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Composer -->
            <Border x:Name="Composer" Grid.Row="2" Margin="20,4,20,16" Style="{StaticResource ComposerBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="10,8,10,0">
                        <TextBox x:Name="Input" Style="{StaticResource BareTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MaxLength="20000" MinHeight="22" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="OnInputPreviewKeyDown" />
                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14"
                                   Foreground="#8A8A8A" Text="Type a message"
                                   Visibility="{Binding Text, ElementName=Input, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>
                    <DockPanel Grid.Row="1" Margin="6,2,6,4">
                        <ToggleButton x:Name="EmojiToggle" Style="{StaticResource IconToggleButton}" Content="&#xE76E;" ToolTip="Emoji" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE723;" ToolTip="Attach files or images" Click="OnAttach" />
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource IconButton}"
                                Foreground="{StaticResource AccentBrush}" Content="&#xE724;" ToolTip="Send (Enter)" Click="OnSend" />
                        <TextBlock x:Name="ComposerHint" Margin="8,0" VerticalAlignment="Center" FontSize="11"
                                   Foreground="#8A8A8A" Text="Enter to send · Shift+Enter for a new line · drop or paste files" />
                    </DockPanel>
                    <Popup x:Name="EmojiPopup" Placement="Top" PlacementTarget="{Binding ElementName=EmojiToggle}"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           IsOpen="{Binding IsChecked, ElementName=EmojiToggle}">
                        <Border Margin="0,0,0,4" Padding="6" Background="White" BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ItemsControl x:Name="EmojiGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="9" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource EmojiButton}" Content="{Binding}" Click="OnEmojiClick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
        </Grid>

        <!-- Nothing selected -->
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontSize="56" FontFamily="{StaticResource IconFont}"
                       Foreground="#C8C8E8" Text="&#xE8BD;" />
            <TextBlock Margin="0,14,0,4" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Text="Pick a chat to start messaging" />
            <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource SubtleTextBrush}"
                       Text="Or start a new one with the ✎ button." />
        </StackPanel>
    </Grid>
</UserControl>
