<UserControl x:Class="MiniLocalChat.Controls.Avatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False">
    <Grid>
        <Ellipse x:Name="Circle" />
        <!-- The person's second color, drawn just inside the edge. -->
        <Ellipse x:Name="RingCircle" Visibility="Collapsed" />
        <TextBlock x:Name="InitialsText" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontFamily="{StaticResource TextFont}" FontWeight="SemiBold" Foreground="White" />
        <TextBlock x:Name="GroupGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                   FontFamily="{StaticResource IconFont}" Foreground="White" Text="&#xE716;" />
        <Ellipse x:Name="PresenceDot" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"
                 Stroke="White" StrokeThickness="2" Visibility="Collapsed" />
    </Grid>
</UserControl>
