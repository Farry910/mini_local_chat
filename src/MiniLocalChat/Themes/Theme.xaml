<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="clr-namespace:MiniLocalChat.Infrastructure"
                    xmlns:m="clr-namespace:MiniLocalChat.Models"
                    xmlns:c="clr-namespace:MiniLocalChat.Controls"
                    xmlns:v="clr-namespace:MiniLocalChat.Views">

    <!-- Teams-like palette -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5B5FC7" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4F52B2" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#E8EBFA" />
    <SolidColorBrush x:Key="RailBrush" Color="#EBEBEB" />
    <SolidColorBrush x:Key="PaneBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="ChatBackgroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#242424" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#616161" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0F000000" />
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI, Segoe UI Emoji</FontFamily>

    <!-- Converters -->
    <i:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <i:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <i:InverseBoolConverter x:Key="InverseBool" />
    <i:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    <i:PathToUriConverter x:Key="PathToUri" />
    <i:CountToVisibilityConverter x:Key="CountToVisibility" />
    <i:CountToVisibilityConverter x:Key="ZeroToVisibility" Invert="True" />
    <i:PositiveConverter x:Key="IsPositive" />
    <i:EmptyToVisibilityConverter x:Key="EmptyToVisible" />
    <i:EmptyToVisibilityConverter x:Key="EmptyToCollapsed" Invert="True" />
    <i:PresenceTextConverter x:Key="PresenceText" />
    <i:MessageTimeConverter x:Key="MessageTime" />
    <i:ListTimeConverter x:Key="ListTime" />
    <i:FileSizeConverter x:Key="FileSize" />
    <i:PathToImageConverter x:Key="PathToImage" />

    <!-- Slim scrollbars -->
    <Style x:Key="SlimThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="#C4C4C4" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#9E9E9E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="10" />
                <Setter Property="MinWidth" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SlimThumb}" Margin="2,2" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Buttons -->
    <Style x:Key="IconButton" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#24000000" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,6" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#C7C7C7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#D1D1D1" BorderThickness="1"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F5F5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RailButton" TargetType="Button">
        <Setter Property="Width" Value="68" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Indicator" Width="3" Margin="0,12" HorizontalAlignment="Left" CornerRadius="2"
                                Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text inputs -->
    <Style x:Key="BareTextBox" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldTextBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="BorderBrush" Value="#D1D1D1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>

    <!-- A row of color swatches; the selected one gets a dark ring. -->
    <Style x:Key="SwatchList" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="8" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="ToolTip" Value="{Binding}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid Width="28" Height="28" Background="Transparent">
                                    <Ellipse x:Name="Selection" Stroke="{StaticResource TextBrush}" StrokeThickness="2" Visibility="Hidden" />
                                    <Ellipse Margin="4" Fill="{Binding}" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Selection" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Selection" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Selection" Property="Stroke" Value="#9E9E9E" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Selection" Property="Stroke" Value="{StaticResource TextBrush}" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tabs (GIF panel, Alarms / Timers): text with an accent underline when selected -->
    <Style x:Key="PanelTab" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent">
                        <ContentPresenter Margin="2,2,2,4" />
                        <Border x:Name="Underline" Height="2" CornerRadius="1" Background="{StaticResource AccentBrush}" Visibility="Hidden" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chat list -->

    <!-- Section header: "Favorites · 2", "Online · 5", "Offline · 3" -->
    <DataTemplate x:Key="SectionHeaderTemplate">
        <TextBlock Margin="18,12,0,4" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}">
            <Run Text="{Binding Name, Mode=OneWay}" />
            <Run Text="·" />
            <Run Text="{Binding ItemCount, Mode=OneWay}" />
        </TextBlock>
    </DataTemplate>

    <!-- Right-click menu on a chat in either list. -->
    <ContextMenu x:Key="ConversationMenu" x:Shared="False">
        <MenuItem Header="Add to favorites" Command="{x:Static v:ChatActions.ToggleFavoriteCommand}" CommandParameter="{Binding}"
                  Visibility="{Binding IsFavorite, Converter={StaticResource InverseBoolToVisibility}}">
            <MenuItem.Icon>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE734;" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Remove from favorites" Command="{x:Static v:ChatActions.ToggleFavoriteCommand}" CommandParameter="{Binding}"
                  Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
            <MenuItem.Icon>
                <TextBlock FontFamily="{StaticResource IconFont}" Foreground="#E3A100" Text="&#xE735;" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Clear chat history…" Command="{x:Static v:ChatActions.ClearHistoryCommand}" CommandParameter="{Binding}">
            <MenuItem.Icon>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE894;" />
            </MenuItem.Icon>
        </MenuItem>
        <Separator Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}" />
        <MenuItem Header="Rename group…" Command="{x:Static v:ChatActions.RenameGroupCommand}" CommandParameter="{Binding}"
                  Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
            <MenuItem.Icon>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8AC;" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Add people…" Command="{x:Static v:ChatActions.AddPeopleCommand}" CommandParameter="{Binding}"
                  Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
            <MenuItem.Icon>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FA;" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Leave group" Command="{x:Static v:ChatActions.LeaveGroupCommand}" CommandParameter="{Binding}"
                  Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
            <MenuItem.Icon>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE89B;" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Delete chat" Command="{x:Static v:ChatActions.DeleteChatCommand}" CommandParameter="{Binding}"
                  Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
            <MenuItem.Icon>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" />
            </MenuItem.Icon>
        </MenuItem>
    </ContextMenu>

    <Style x:Key="ConversationItemStyle" TargetType="ListBoxItem">
        <Setter Property="ContextMenu" Value="{StaticResource ConversationMenu}" />
        <Setter Property="Margin" Value="6,1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#80FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="ConversationItemTemplate" DataType="{x:Type m:Conversation}">
        <Grid Margin="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <c:Avatar Grid.RowSpan="2" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center"
                      Text="{Binding AvatarText}" Fill="{Binding AvatarBrush}" Image="{Binding AvatarImage}" IsGroup="{Binding IsGroup}"
                      ShowPresence="{Binding IsGroup, Converter={StaticResource InverseBool}}"
                      IsOnline="{Binding Peer.IsOnline, FallbackValue=False}" />

            <DockPanel Grid.Column="1">
                <!-- Ripples from this person are blocked. -->
                <TextBlock DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"
                           FontFamily="{StaticResource IconFont}" Foreground="#C4314B" Text="&#xE733;"
                           ToolTip="Ripples from this person are blocked"
                           Visibility="{Binding Peer.RippleBlocked, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14"
                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Text="{Binding LastActivityUtc, Converter={StaticResource ListTime}}" />

            <c:EmojiLabel x:Name="PreviewText" Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" FontSize="12"
                       FontFamily="{StaticResource TextFont}" Foreground="{StaticResource SubtleTextBrush}"
                       Text="{Binding LastPreview}" />
            <Border Grid.Row="1" Grid.Column="2" Height="18" MinWidth="18" Margin="8,2,0,0" Padding="5,0"
                    HorizontalAlignment="Right" CornerRadius="9" Background="{StaticResource AccentBrush}"
                    Visibility="{Binding UnreadCount, Converter={StaticResource CountToVisibility}}">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                           Foreground="White" Text="{Binding UnreadCount}" />
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding UnreadCount, Converter={StaticResource IsPositive}}" Value="True">
                <Setter TargetName="TitleText" Property="FontWeight" Value="Bold" />
                <Setter TargetName="PreviewText" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="PreviewText" Property="Foreground" Value="{StaticResource TextBrush}" />
            </DataTrigger>
            <!-- Last, so it wins: "typing…" replaces the preview while someone types. -->
            <DataTrigger Binding="{Binding IsTyping}" Value="True">
                <Setter TargetName="PreviewText" Property="Text" Value="{Binding TypingPreview}" />
                <Setter TargetName="PreviewText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="PreviewText" Property="FontStyle" Value="Italic" />
                <Setter TargetName="PreviewText" Property="FontWeight" Value="Normal" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
