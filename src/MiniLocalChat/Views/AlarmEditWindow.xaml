<Window x:Class="MiniLocalChat.Views.AlarmEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" Background="White">
    <Window.Resources>
        <!-- Round day toggles: M T W T F S S -->
        <Style x:Key="DayToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="White" Stroke="#C7C7C7" StrokeThickness="1" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Bg" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="New alarm" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Time" />
        <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="HourBox" Width="70" FontSize="20" Padding="8,4" />
            <TextBlock Margin="8,0" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text=":" />
            <ComboBox x:Name="MinuteBox" Width="70" FontSize="20" Padding="8,4" />
            <TextBlock x:Name="TimePreview" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource SubtleTextBrush}" />
        </StackPanel>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Label" />
        <TextBox x:Name="LabelBox" Style="{StaticResource FieldTextBox}" MaxLength="60" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Repeat" />
        <StackPanel x:Name="DayPanel" Orientation="Horizontal" />
        <TextBlock x:Name="RepeatHint" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Wave colors" />
        <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="First wave" />
        <ListBox x:Name="Color1List" Style="{StaticResource SwatchList}" />
        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="Second wave" />
        <ListBox x:Name="Color2List" Style="{StaticResource SwatchList}" />
        <DockPanel Margin="0,8,0,0">
            <Button x:Name="PreviewButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Preview" Click="OnPreview" />
            <CheckBox x:Name="SoundBox" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="13" Content="Play the alarm sound too" />
        </DockPanel>

        <DockPanel Margin="0,22,0,0">
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Foreground="#C4314B"
                    Content="Delete" Visibility="Collapsed" Click="OnDelete" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" />
                <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Content="Save" IsDefault="True" Click="OnSave" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
