<Window x:Class="MiniLocalChat.Views.TimerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MiniLocalChat.Controls"
        Title="Timer" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" Background="White">
    <Window.Resources>
        <Style x:Key="Preset" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="12" Background="{StaticResource PaneBrush}"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="New timer" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Duration" />
        <!-- Counter-style: ▲▼, mouse wheel, arrow keys or typing -->
        <StackPanel Orientation="Horizontal">
            <StackPanel>
                <c:NumberSpinner x:Name="HoursSpinner" Maximum="23" />
                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Text="hours" />
            </StackPanel>
            <TextBlock Margin="8,0,8,18" VerticalAlignment="Center" FontSize="30" FontWeight="SemiBold" Text=":" />
            <StackPanel>
                <c:NumberSpinner x:Name="MinutesSpinner" Maximum="59" />
                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Text="minutes" />
            </StackPanel>
            <TextBlock Margin="8,0,8,18" VerticalAlignment="Center" FontSize="30" FontWeight="SemiBold" Text=":" />
            <StackPanel>
                <c:NumberSpinner x:Name="SecondsSpinner" Maximum="59" />
                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Text="seconds" />
            </StackPanel>
        </StackPanel>
        <WrapPanel x:Name="Presets" Margin="0,12,0,0" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Label" />
        <TextBox x:Name="LabelBox" Style="{StaticResource FieldTextBox}" MaxLength="60" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Wave colors" />
        <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="First wave" />
        <ListBox x:Name="Color1List" Style="{StaticResource SwatchList}" />
        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="Second wave" />
        <ListBox x:Name="Color2List" Style="{StaticResource SwatchList}" />
        <CheckBox x:Name="SoundBox" Margin="0,8,0,0" VerticalContentAlignment="Center" FontSize="13" Content="Play the alarm sound too" />
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" FontSize="12" Foreground="#C4314B" Visibility="Collapsed" Text="Set a duration of at least one second." />

        <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" />
            <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="Save" Click="OnSave" />
            <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Content="Start" IsDefault="True" Click="OnStart" />
        </StackPanel>
    </StackPanel>
</Window>
