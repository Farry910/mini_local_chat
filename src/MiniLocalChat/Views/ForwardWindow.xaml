<Window x:Class="MiniLocalChat.Views.ForwardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MiniLocalChat.Controls"
        Title="Forward" Width="420" Height="540" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" Background="White">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="Forward" />

        <!-- What is being forwarded -->
        <Border Grid.Row="1" Margin="0,10,0,12" Padding="10,6" Background="{StaticResource PaneBrush}" CornerRadius="4"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0">
            <TextBlock x:Name="PreviewText" FontSize="13" FontFamily="{StaticResource TextFont}" Foreground="{StaticResource TextBrush}"
                       TextTrimming="CharacterEllipsis" MaxHeight="40" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Height="32" Margin="0,0,0,8" Background="White" CornerRadius="4"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
            <DockPanel Margin="8,0">
                <TextBlock VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource IconFont}"
                           Foreground="{StaticResource SubtleTextBrush}" Text="&#xE721;" />
                <Grid Margin="6,0,0,0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource BareTextBox}" FontSize="13" TextChanged="OnSearchChanged" />
                    <TextBlock Margin="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13"
                               Foreground="#8A8A8A" Text="Search people and chats"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}" />
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TargetList" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="6,4" Padding="8,0,0,0" VerticalContentAlignment="Center" Cursor="Hand"
                                      IsChecked="{Binding IsSelected}">
                                <DockPanel>
                                    <c:Avatar Width="30" Height="30" Margin="0,0,10,0"
                                              Text="{Binding Conversation.AvatarText}" Fill="{Binding Conversation.AvatarBrush}"
                                              Ring="{Binding Conversation.AvatarRing}" IsGroup="{Binding Conversation.IsGroup}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource TextBrush}"
                                               Text="{Binding Conversation.Title}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" />
            <Button x:Name="SendButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Content="Forward"
                    IsDefault="True" IsEnabled="False" Click="OnSend" />
        </StackPanel>
    </Grid>
</Window>
