<Window x:Class="MiniLocalChat.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        xmlns:c="clr-namespace:MiniLocalChat.Controls"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" Background="White">

    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="Settings" />
        <TextBlock x:Name="Intro" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource SubtleTextBrush}"
                   Visibility="Collapsed"
                   Text="Welcome! Choose the nickname and colors everyone on the network will see. Your IP address is your identity, so they always belong to this computer." />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Your nickname" />
        <TextBox x:Name="NicknameBox" Style="{StaticResource FieldTextBox}" />
        <TextBlock x:Name="NicknameError" Margin="0,4,0,0" FontSize="12" Foreground="#C4314B" Visibility="Collapsed"
                   Text="Please enter a nickname." />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Your picture and colors" />
        <DockPanel>
            <StackPanel DockPanel.Dock="Left" Width="72" Margin="0,2,12,0">
                <c:Avatar x:Name="ColorPreview" Width="56" Height="56" HorizontalAlignment="Center" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12">
                    <Hyperlink Click="OnChoosePicture" Foreground="{StaticResource AccentBrush}">Choose picture…</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="RemovePictureLink" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12">
                    <Hyperlink Click="OnRemovePicture" Foreground="{StaticResource SubtleTextBrush}">Remove picture</Hyperlink>
                </TextBlock>
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="Avatar background · first wave" />
                <ListBox x:Name="Color1List" Style="{StaticResource SwatchList}" SelectionChanged="OnColorChanged" />
                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="Second wave" />
                <ListBox x:Name="Color2List" Style="{StaticResource SwatchList}" SelectionChanged="OnColorChanged" />
            </StackPanel>
        </DockPanel>
        <DockPanel Margin="0,6,0,0">
            <Button x:Name="PreviewRippleButton" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"
                    Style="{StaticResource SecondaryButton}" Content="Preview ripple" Click="OnPreviewRipple" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                       Text="Everyone sees your picture (or your initials on the first color), and their screen ripples in these two colors when you message them." />
        </DockPanel>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Your IP address (your identity)" />
        <ComboBox x:Name="IpCombo" FontSize="13" Padding="6,5" />
        <TextBlock x:Name="IpNote" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                   Text="Only change this if your computer has several network adapters." />

        <StackPanel x:Name="MoreSettings">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Floating LED (shown while the app is in the tray)" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="LedLeft" Margin="0,0,20,0" VerticalContentAlignment="Center" FontSize="13" Content="Left side of the screen" />
                <RadioButton x:Name="LedRight" VerticalContentAlignment="Center" FontSize="13" Content="Right side" />
            </StackPanel>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                       Text="You can also drag the LED up or down, or over to the other side." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="New message alert" />
            <CheckBox x:Name="RippleBox" VerticalContentAlignment="Center" FontSize="13"
                      Content="Ripple across the screen in the sender's colors" />
            <StackPanel Margin="22,8,0,0" Orientation="Horizontal"
                        IsEnabled="{Binding IsChecked, ElementName=RippleBox}">
                <TextBlock VerticalAlignment="Center" FontSize="13" Text="At most once every" />
                <TextBox x:Name="RippleGapBox" Width="48" Margin="8,0" Style="{StaticResource FieldTextBox}"
                         HorizontalContentAlignment="Right" MaxLength="2" />
                <TextBlock VerticalAlignment="Center" FontSize="13" Text="seconds" />
            </StackPanel>
            <TextBlock x:Name="RippleError" Margin="22,4,0,0" FontSize="12" Foreground="#C4314B" Visibility="Collapsed" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Can't see other people?" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}"
                        Content="Allow through firewall" Click="OnAllowFirewall" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                           Text="Windows Firewall may be blocking the app. Do this once on each computer (asks for admin rights)." />
            </DockPanel>
            <TextBlock x:Name="FirewallResult" Margin="0,4,0,0" FontSize="12" Visibility="Collapsed" />

            <CheckBox x:Name="AutoStartBox" Margin="0,16,0,0" VerticalContentAlignment="Center" FontSize="13"
                      Content="Start Mini Local Chat when I sign in to Windows" />

            <TextBlock Margin="0,16,0,0" FontSize="12" Foreground="{StaticResource SubtleTextBrush}">
                <Run Text="Chats and received files are stored in " />
                <Hyperlink Click="OnOpenDataFolder" Foreground="{StaticResource AccentBrush}">your data folder</Hyperlink>
                <Run Text="." />
            </TextBlock>
            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap">
                <Hyperlink Click="OnOpenEmojiCredit" Foreground="{StaticResource SubtleTextBrush}">Animated emoji: Noto Emoji by Google</Hyperlink>
                <Run Text=", licensed CC BY 4.0." />
            </TextBlock>
        </StackPanel>

        <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" />
            <Button x:Name="SaveButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Content="Save" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
