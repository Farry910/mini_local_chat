<UserControl x:Class="MiniLocalChat.Views.AlarmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:MiniLocalChat.Models"
             Background="{StaticResource ChatBackgroundBrush}">
    <UserControl.Resources>
        <!-- On/off switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="10" Background="White" BorderBrush="#8A8A8A" BorderThickness="1" />
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" Fill="#616161" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AlarmCard" DataType="{x:Type m:Alarm}">
            <Border x:Name="Card" Margin="0,0,0,10" Padding="18,14" Background="White" CornerRadius="8"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Cursor="Hand"
                    MouseLeftButtonUp="OnEditAlarm">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Switch}"
                              IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnToggleAlarm" ToolTip="On / off" />
                    <Button DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource IconButton}"
                            Content="&#xE74D;" ToolTip="Delete alarm" Click="OnDeleteAlarm" />
                    <!-- Wave colors -->
                    <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Ellipse Width="14" Height="14" Fill="{Binding Brush1}" />
                        <Ellipse Width="14" Height="14" Margin="0,4,0,0" Fill="{Binding Brush2}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="Time" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding TimeText}" />
                        <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource SubtleTextBrush}">
                            <Run Text="{Binding RepeatText, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding NextText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter TargetName="Time" Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="28,18" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="OnNewAlarm">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource IconFont}" Text="&#xE710;" />
                        <TextBlock Text="New alarm" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="Alarms" />
                    <TextBlock x:Name="NextSummary" Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AlarmList" Margin="28,18" MaxWidth="720" HorizontalAlignment="Stretch"
                          ItemTemplate="{StaticResource AlarmCard}" />
        </ScrollViewer>

        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontSize="48" FontFamily="{StaticResource IconFont}" Foreground="#C8C8E8" Text="&#xEA8F;" />
            <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Text="No alarms yet" />
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" FontSize="13"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Text="When an alarm rings, your screen waves in its colors until you snooze or dismiss it. Alarms ring while Mini Local Chat is running, also from the tray." />
        </StackPanel>
    </Grid>
</UserControl>
