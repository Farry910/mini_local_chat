<UserControl x:Class="MiniLocalChat.Views.AlarmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:MiniLocalChat.Models"
             Background="{StaticResource ChatBackgroundBrush}">
    <UserControl.Resources>
        <!-- On/off switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="10" Background="White" BorderBrush="#8A8A8A" BorderThickness="1" />
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" Fill="#616161" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AlarmCard" DataType="{x:Type m:Alarm}">
            <Border x:Name="Card" Margin="0,0,0,10" Padding="18,14" Background="White" CornerRadius="8"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Cursor="Hand"
                    MouseLeftButtonUp="OnEditAlarm">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Switch}"
                              IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnToggleAlarm" ToolTip="On / off" />
                    <Button DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource IconButton}"
                            Content="&#xE74D;" ToolTip="Delete alarm" Click="OnDeleteAlarm" />
                    <!-- Wave colors -->
                    <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Ellipse Width="14" Height="14" Fill="{Binding Brush1}" />
                        <Ellipse Width="14" Height="14" Margin="0,4,0,0" Fill="{Binding Brush2}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="Time" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding TimeText}" />
                        <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource SubtleTextBrush}">
                            <Run Text="{Binding RepeatText, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding NextText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter TargetName="Time" Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Countdown timer card: big remaining time, progress line, play/pause, reset, delete -->
        <DataTemplate x:Key="TimerCard" DataType="{x:Type m:TimerItem}">
            <Border x:Name="Card" Margin="0,0,0,10" Padding="18,14" Background="White" CornerRadius="8"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="OnEditTimer">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource IconButton}"
                                Content="&#xE74D;" ToolTip="Delete timer" Click="OnDeleteTimer" />
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource IconButton}"
                                Content="&#xE72C;" ToolTip="Reset" Click="OnResetTimer" />
                        <Button x:Name="PlayPause" DockPanel.Dock="Right" Width="44" Height="44" VerticalAlignment="Center"
                                Click="OnPlayPauseTimer" ToolTip="Start">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="Circle" Fill="{StaticResource AccentBrush}" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Circle" Property="Fill" Value="{StaticResource AccentHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="PlayGlyph" FontSize="16" FontFamily="{StaticResource IconFont}" Foreground="White" Text="&#xE768;" />
                        </Button>
                        <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Ellipse Width="14" Height="14" Fill="{Binding Brush1}" />
                            <Ellipse Width="14" Height="14" Margin="0,4,0,0" Fill="{Binding Brush2}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="Remaining" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                       Typography.NumeralAlignment="Tabular" Text="{Binding RemainingText}" />
                            <TextBlock FontSize="13" Foreground="{StaticResource TextBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="{Binding StateText}" />
                        </StackPanel>
                    </DockPanel>
                    <!-- Progress line in the timer's first color -->
                    <Grid Height="4" Margin="0,12,0,0">
                        <Border CornerRadius="2" Background="{StaticResource PaneBrush}" />
                        <Border CornerRadius="2" Background="{Binding Brush1}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Progress}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="PlayGlyph" Property="Text" Value="&#xE769;" />
                    <Setter TargetName="PlayPause" Property="ToolTip" Value="Pause" />
                    <Setter TargetName="Remaining" Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="28,14,28,0" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="NewButton" DockPanel.Dock="Right" AutomationProperties.Name="{Binding Text, ElementName=NewButtonText}" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="OnNew">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource IconFont}" Text="&#xE710;" />
                        <TextBlock x:Name="NewButtonText" Text="New alarm" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="AlarmsTab" Style="{StaticResource PanelTab}" FontSize="18" Content="Alarms" IsChecked="True"
                                     AutomationProperties.Name="Alarms tab" Checked="OnTabChanged" />
                        <RadioButton x:Name="TimersTab" Style="{StaticResource PanelTab}" FontSize="18" Content="Timers"
                                     AutomationProperties.Name="Timers tab" Checked="OnTabChanged" />
                    </StackPanel>
                    <TextBlock x:Name="NextSummary" Margin="0,4,0,12" FontSize="13" Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="AlarmsPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AlarmList" Margin="28,18" MaxWidth="720" HorizontalAlignment="Stretch"
                          ItemTemplate="{StaticResource AlarmCard}" />
        </ScrollViewer>

        <ScrollViewer x:Name="TimersPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <ItemsControl x:Name="TimerList" Margin="28,18" MaxWidth="720" HorizontalAlignment="Stretch"
                          ItemTemplate="{StaticResource TimerCard}" />
        </ScrollViewer>

        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="EmptyGlyph" HorizontalAlignment="Center" FontSize="48" FontFamily="{StaticResource IconFont}" Foreground="#C8C8E8" Text="&#xEA8F;" />
            <TextBlock x:Name="EmptyTitle" Margin="0,12,0,4" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Text="No alarms yet" />
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" FontSize="13"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Text="When an alarm rings, your screen waves in its colors until you snooze or dismiss it. Alarms ring while Mini Local Chat is running, also from the tray." />
        </StackPanel>
    </Grid>
</UserControl>
