<Window x:Class="MiniLocalChat.Views.MiniChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MiniLocalChat.Controls"
        Title="Mini Local Chat" Width="380" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI">
    <!-- 10px transparent margin leaves room for the drop shadow. -->
    <Grid Margin="10">
        <Border CornerRadius="8" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="8" Background="{StaticResource ChatBackgroundBrush}" BorderBrush="#D0D0D0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border CornerRadius="7,7,0,0" Background="{StaticResource AccentBrush}">
                    <DockPanel Margin="6,0">
                        <Button x:Name="BackButton" Style="{StaticResource HeaderIconButton}" Content="&#xE72B;"
                                ToolTip="Back to all chats" Visibility="Collapsed" Click="OnBack" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource HeaderIconButton}" Content="&#xE8A7;"
                                ToolTip="Open the full app" Click="OnOpenApp" />
                        <!-- Pin: keep this panel open -->
                        <Button x:Name="PinButton" DockPanel.Dock="Right" Style="{StaticResource HeaderIconButton}" Content="&#xE718;"
                                AutomationProperties.Name="Pin" Click="OnTogglePin" />
                        <!-- Global ripple switch -->
                        <Button x:Name="RippleToggleButton" DockPanel.Dock="Right" Style="{StaticResource HeaderIconButton}"
                                AutomationProperties.Name="Ripples" Click="OnToggleRipples">
                            <Grid>
                                <TextBlock Text="&#xE701;" />
                                <TextBlock x:Name="RippleOffMark" Text="&#xE711;" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button x:Name="NewMessageButton" DockPanel.Dock="Right" Style="{StaticResource HeaderIconButton}" Content="&#xE70F;"
                                ToolTip="New message" Click="OnNewMessage" />
                        <Button x:Name="FindButton" DockPanel.Dock="Right" Style="{StaticResource HeaderIconButton}" Content="&#xE721;"
                                ToolTip="Search in this chat (Ctrl+F)" Visibility="Collapsed" Click="OnFindInChat" />
                        <c:RippleBlockButton x:Name="RippleBlock" DockPanel.Dock="Right" OnAccent="True" Visibility="Collapsed" />
                        <StackPanel Margin="8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitle" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                       TextTrimming="CharacterEllipsis" Text="Chats" />
                            <!-- In a chat: online/offline (1:1) or the members (group). -->
                            <TextBlock x:Name="HeaderStatus" FontSize="11" Foreground="#E0FFFFFF" TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <DockPanel x:Name="ListPanel">
                        <Border DockPanel.Dock="Top" Height="30" Margin="10,8,10,0" Background="White" CornerRadius="4"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                            <DockPanel Margin="8,0">
                                <TextBlock VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource IconFont}"
                                           Foreground="{StaticResource SubtleTextBrush}" Text="&#xE721;" />
                                <Grid Margin="6,0,0,0">
                                    <TextBox x:Name="SearchBox" Style="{StaticResource BareTextBox}" FontSize="13" TextChanged="OnSearchChanged" />
                                    <TextBlock Margin="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13"
                                               Foreground="#8A8A8A" Text="Search people and chats"
                                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                        <!-- Not synced with the view's current item, or the first chat would open by itself. -->
                        <ListBox x:Name="ChatList" Padding="0,0,0,6" Background="Transparent" BorderThickness="0"
                                 IsSynchronizedWithCurrentItem="False"
                                 ItemTemplate="{StaticResource ConversationItemTemplate}"
                                 ItemContainerStyle="{StaticResource ConversationItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnChatSelected">
                            <ListBox.GroupStyle>
                                <GroupStyle HidesIfEmpty="True" HeaderTemplate="{StaticResource SectionHeaderTemplate}" />
                            </ListBox.GroupStyle>
                        </ListBox>
                    </DockPanel>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Center" FontSize="40" FontFamily="{StaticResource IconFont}"
                                   Foreground="#B4B6E6" Text="&#xE716;" />
                        <TextBlock Margin="0,10,0,2" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Text="Looking for people…" />
                        <TextBlock Margin="20,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   Text="Everyone running Mini Local Chat on your network appears here automatically." />
                    </StackPanel>

                    <c:ChatView x:Name="ChatPane" IsCompact="True" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
