<Window x:Class="MiniLocalChat.Views.AlarmRingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True" ShowActivated="False" FontFamily="Segoe UI">
    <!-- 10px margin leaves room for the shadow. -->
    <Grid Margin="10">
        <Border CornerRadius="10" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="10" Background="White" BorderBrush="#D6D6D6" BorderThickness="1" ClipToBounds="True">
            <StackPanel>
                <!-- The alarm's two wave colors -->
                <Grid Height="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Color1Strip" />
                    <Border x:Name="Color2Strip" Grid.Column="1" />
                </Grid>
                <DockPanel Margin="20,16,20,4">
                    <TextBlock x:Name="BellGlyph" DockPanel.Dock="Left" Margin="0,0,14,0" VerticalAlignment="Center" FontSize="30"
                               FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}" Text="&#xEA8F;"
                               RenderTransformOrigin="0.5,0.1">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="BellSwing" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <StackPanel>
                        <TextBlock x:Name="TimeText" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="LabelText" FontSize="14" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Margin="20,14,20,18" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="Snooze 5 min" Click="OnSnooze" />
                    <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Content="Dismiss" Click="OnDismiss" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
