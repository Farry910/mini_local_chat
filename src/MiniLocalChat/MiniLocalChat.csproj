<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon) and monitor work areas (Screen). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MiniLocalChat</RootNamespace>
    <AssemblyName>MiniLocalChat</AssemblyName>
    <Product>Mini Local Chat</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms types out of the global namespace so they don't clash with WPF ones. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
