<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon) and monitor work areas (Screen). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MiniLocalChat</RootNamespace>
    <!-- Exe icon (Explorer, taskbar, shortcuts). Regenerate with tools\make-icon.ps1. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>MiniLocalChat</AssemblyName>
    <Product>Mini Local Chat</Product>
    <!-- Shown in the title bar, together with the git commit the build came from. -->
    <Version>1.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms types out of the global namespace so they don't clash with WPF ones. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="XamlAnimatedGif" Version="2.3.2" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <!-- Telegram animated stickers (.tgs = gzipped Lottie) are drawn with Skia's Lottie player. -->
    <PackageReference Include="SkiaSharp" Version="4.152.3" />
    <PackageReference Include="SkiaSharp.Skottie" Version="4.152.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in animated emoji stickers (Google Noto Animated Emoji, CC BY 4.0). Embedded so the
         single-file exe carries them; unpacked on first run. Regenerate with tools\fetch-emoji.ps1. -->
    <EmbeddedResource Include="Assets\Emoji\*.gif" LogicalName="Emoji.%(Filename)%(Extension)" />
    <!-- Built-in Telegram stickers (.tgs), unpacked into the sticker library on first run. -->
    <EmbeddedResource Include="Assets\Stickers\*.tgs" LogicalName="Sticker.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
